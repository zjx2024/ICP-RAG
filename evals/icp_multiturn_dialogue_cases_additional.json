      "turns": [
        {
          "id": "distinguish",
          "question": "后台数据和告警计数仍在变化，但主画面像被冻结，切到备用安全画面却能继续显示；这和外部输出接口完全没信号有什么区别？",
          "assertions": {
            "required_tools": ["function_locator", "fmeca_query"],
            "required_used_doc_types": ["function_locator", "fmeca"],
