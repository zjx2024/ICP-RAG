            "required_answer_facets": ["resolution", "history_action", "history_result"],
            "answer_regex": ["DPM|帧缓存|OIM", "软件|复位", "验证|恢复"]
          }
        }
      ]
    },
    {
      "id": "MT-FBM-01-frame-integrity",
      "metadata": {
        "category": "显示帧缓存完整性",
        "coverage": ["fmeca_query", "mfl_query", "fault_history_query"],
        "expected_records": ["MFL-SYN-047", "HIS-SYN-016"]
