        },
        {
          "id": "acceptance",
          "question": "维修后怎样安排分辨率、颜色和帧校验复测？如果缺陷仍随页面变化，下一步应怎么处理？",
          "assertions": {
            "required_tools": ["mfl_query", "fault_history_query"],
            "required_used_doc_types": ["mfl", "fault_history"],
            "any_used_record_ids": ["MFL-SYN-047", "HIS-SYN-016"],
            "required_answer_facets": ["resolution", "history_result"],
            "answer_regex": ["分辨率|颜色|帧校验", "复测|验证", "更换|继续排查"]
          }
        }
      ]
    },
    {
      "id": "MT-DCS-01-switch-readback",
      "metadata": {
        "category": "显示通道切换回读不一致",
        "coverage": ["function_locator", "fmeca_query", "mfl_query", "fault_history_query"],
