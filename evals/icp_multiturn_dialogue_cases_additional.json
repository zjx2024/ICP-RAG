          }
        },
        {
          "id": "history_fix",
          "question": "怎样进一步排除帧缓存和 OIM，历史案例最后是如何处置的？请给出软件修复、受控复位和验证要点。",
          "assertions": {
            "required_tools": ["mfl_query", "fault_history_query"],
