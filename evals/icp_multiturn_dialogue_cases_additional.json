        {
          "id": "verify",
          "question": "如何用命令—回读一致性确认修复有效？历史案例最后是否更换了切换模块，还做了哪些校准？",
          "assertions": {
            "required_tools": ["mfl_query", "fault_history_query"],
            "required_used_doc_types": ["mfl", "fault_history"],
            "any_used_record_ids": ["MFL-SYN-052", "HIS-SYN-018"],
