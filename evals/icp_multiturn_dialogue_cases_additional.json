      "turns": [
        {
          "id": "isolate",
          "question": "屏幕仍有内容，却出现随机方块和局部颜色跳变；换页面后缺陷位置也变了，重启只能暂时缓解。优先怀疑哪一层？",
          "assertions": {
            "required_tools": ["fmeca_query"],
            "required_used_doc_types": ["fmeca"],
            "any_used_record_ids": ["FM-SYN-047"],
            "answer_regex": ["FBM|帧缓存", "帧|缓存", "完整性|校验"]
