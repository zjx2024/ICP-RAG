{
  "version": "2026-09-09-gate-calibration-v1",
  "description": "M0正反配对：由助手依据内嵌合成来源编制，不是独立领域专家标注或航空维修资料。固定后用于评测裁判与减负审核对照；不是线上单例验收。",
  "cases": [
    {
      "id": "manual-check-not-api-list",
      "question": "维修清单对输出异常给了哪些物理检查？",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "M-17记载检查连接和输出驱动，可直接API上报：否，API名称：—；该行仍记载读取状态字结合接口时钟检查。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "回答物理检查即可，不要求API清单；不得把不可直接上报写成有已确认直接API。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "资料建议检查连接、输出驱动及接口时钟。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "可以调用ReadOutputStatus()直接上报该故障，然后更换模块。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "explicit-api-is-required",
      "question": "这些检查有哪些已确认可直接调用的接口？",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "M-17可直接上报：否，API名称：—；M-18可直接上报：是，API名称：ReadModeStatus，调用：事件订阅。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "必须回应明确接口问题，按行说明可用性，不能仅列物理检查。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "M-17没有已确认的直接上报API；M-18可通过ReadModeStatus订阅事件。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "检查连接、输出驱动和接口时钟。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "validated-input-not-enumeration",
      "question": "仅用已验证数据给出两个模型的结果并指出较低者。",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "模型A已验证计算结果0.94；模型B已验证计算结果0.87。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "需正确对应结果与最低项，不额外要求列所有输入参数；模型结果不能互换。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "A为0.94，B为0.87，B较低。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "A为0.87，B为0.94，A较低。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "explicit-input-enumeration",
      "question": "给出结果，同时列明所用参数及单位。",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "模型A输入故障率0.02每小时、时间3小时；确定性计算结果0.94176453。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "用户明确要求参数及单位，不能只报最终结果。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "已用故障率0.02每小时、任务时间3小时，计算结果0.94176453。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "计算结果是0.94176453。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "followup-dimensions",
      "question": "相近案例在什么条件出现，如何验证修复恢复？",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "案例H-73在高温高负荷时中断；压接连接器后连续接收2小时无丢帧，未记载通用放行标准。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "须给发生条件和恢复验证，不能以维修动作代替或把案例当通用放行标准。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "在高温、高负荷下出现；压接后连续接收2小时无丢帧。这是该案例的恢复验证记录。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "故障原因是连接器，处理为重新压接；任何设备压接后都可以放行。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "source-absence-not-missing-relation",
      "question": "当前报码在维修清单有对应接口吗？",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "HMC记录C-19有检查接线；MFL记录M-25有接口QueryState。两表没有显式代码关系。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "未确认对应关系不等于不存在接口，也不能用同现象擅自确认对应。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "没有证实当前报码与维修清单记录的对应关系，因而暂不能确认其接口；这不等于清单没有接口。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "维修清单没有接口，只能检查接线。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "phase-qualification",
      "question": "模块暂时不可用，先影响什么？目前没有给定运行阶段。",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "架构仅明确启动时先加载该模块模板，再初始化任务。未说明运行中短时不可用的影响顺序。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "保留启动阶段条件；不能把启动条件扩为任意运行状态下确定顺序。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "若正在启动，首先阻碍模板加载和任务初始化；运行中暂时不可用的影响顺序，资料不足以确定。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "任何阶段都会首先导致整机任务停机。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "minimal-answer-not-all-fields",
      "question": "What is the module's role?",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "Module K stores templates. The source also contains its mass, serial number and maintenance intervals."
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "回答职责即可，不要求额外字段；不能编造其他模块职责。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "It stores templates.",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "It controls the propulsion system.",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "counts-not-causal-proof",
      "question": "为什么甲模型的概率比乙低？",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "甲0.91、乙0.95。甲含更多串联块，但各块参数不同，未进行敏感性或贡献分析。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "不能仅因块多就断言这是主要原因；区分已算结果与原因尚需分析。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "结果确为甲低；但块数和各块参数都影响结果，现有资料不足以确认主要贡献因素。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "已证明主要原因仅是甲的串联块更多。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    },
    {
      "id": "normal-format-not-code-change",
      "question": "解释记录R-028记载的影响。",
      "reference_context": [
        {
          "source": "内嵌合成事实",
          "text": "记录R-028记载输出更新延迟；没有R-029的记录。"
        }
      ],
      "criteria": [
        {
          "id": "core_and_fidelity",
          "criterion": "粗体或行内代码不改变记录身份；不能换成其他业务记录。"
        }
      ],
      "answers": [
        {
          "id": "valid",
          "text": "**R-028**记载输出更新延迟。",
          "expected": {
            "core_and_fidelity": true
          }
        },
        {
          "id": "invalid",
          "text": "R-029记载输出更新延迟。",
          "expected": {
            "core_and_fidelity": false
          }
        }
      ]
    }
  ]
}
