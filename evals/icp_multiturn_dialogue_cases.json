{
  "name": "ICP 智能体多轮对话回归集",
  "version": "2026-09-02",
  "description": "基于 test-docs 中的合成资料编写。每组 turns 必须在同一会话依次发送，用于检验指代消解、问题意图、资料路由、跨文档补全、来源边界和数值计算授权；不可作为真实维修依据。所有问法均为重新措辞，不直接复用样例文档原句。",
  "defaults": {
    "assertions": {
      "required_event_types": ["answer", "done"],
      "answer_not_contains": [
        "待复核（未绑定已批准直接证据）",
        "证据边界：部分说明未附可直接核验的来源",
        "当前已批准证据不足以支持可直接陈述的事实结论",
        "\\\"record_id\\\"",
        "\\\"answer_fields\\\"",
        "occurred_at=",
        "verification_result=",
        "final_solution="
      ]
    }
  },
  "cases": [
    {
      "id": "MT-ARCH-01-module-context",
      "metadata": {
        "category": "架构基础信息与指代追问",
        "coverage": ["function_locator", "conversation_state"],
        "expected_records": ["MOD-GPP-MSM", "FUNC-230"]
      },
      "turns": [
        {
          "id": "definition",
          "question": "MOD-GPP-MSM 这个部件在系统里做什么？请说出它的中文名称、归属和主要职责。",
          "assertions": {
            "required_scope_routes": ["knowledge_base"],
            "required_tools": ["function_locator"],
            "required_used_doc_types": ["function_locator"],
            "required_used_record_ids": ["MOD-GPP-MSM"],
            "min_citations": 1,
            "answer_regex": ["模板|数据|存储"]
          }
        },
        {
          "id": "importance",
          "question": "那它为什么重要？如果它暂时不可用，任务侧最先受影响的是什么？",
          "metadata": {"checks": "必须把“它”解析为上一轮 MOD-GPP-MSM，而不是泛化到任意模块。"},
          "assertions": {
            "required_scope_routes": ["knowledge_base"],
            "required_tools": ["function_locator"],
            "required_used_doc_types": ["function_locator"],
            "min_citations": 1,
            "answer_regex": ["模板|任务|数据"]
          }
        }
      ]
    },
