      "assertions": {
        "required_tools": ["fta_query", "graph_traversal"],
        "any_doc_types": ["fta", "fmeca", "mfl"],
        "answer_regex": ["OIM|输出接口|显示输出"]
      }
    },
    {
      "id": "missing-new-fault-record",
      "question": "刚出的问题，事后记录里完全查不到。",
      "metadata": {
        "category": "短现象定位",
        "expected_records": ["FUNC-530", "FM-SYN-061", "FM-SYN-062", "FM-SYN-063", "FTA-SYN-006"],
