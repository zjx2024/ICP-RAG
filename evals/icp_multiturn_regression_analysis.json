      "id": "MT-CAUSE-01-pdu-branch-stuck",
      "metadata": {"category": "原因追问与处置闭环", "coverage": ["fmeca_query", "mfl_query"], "expected_records": ["FM-SYN-010", "91810004**0001", "MFL-SYN-010"]},
      "turns": [
        {"id": "cause", "question": "某一个负载支路始终没有电，重新下发接通指令也没有反应，为什么会这样？",
         "assertions": {"required_scope_routes": ["knowledge_base"], "required_tools": ["fmeca_query"], "required_doc_types": ["fmeca"], "required_answer_facets": ["cause", "impact"], "answer_regex": ["PDU|支路|开关|卡滞|驱动"]}},
        {"id": "confirm", "question": "怎么确认是开关卡滞而不是负载短路？需要看哪几个量？",
         "assertions": {"any_tools": ["mfl_query", "fmeca_query"], "any_used_doc_types": ["mfl", "fmeca"], "answer_regex": ["回读|命令|支路电压|开关|负载"]}}
      ]
    },
    {
