      "turns": [
        {"id": "probability", "question": "外部数据通信中断这棵故障树的顶事件近似概率是多少？",
         "assertions": {"required_tools": ["fta_query", "fta_analyzer"], "forbidden_tools": ["graph_traversal"], "required_doc_types": ["fta"], "answer_regex": ["1\\.?910e-?03"]}},
