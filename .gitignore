# Local environment and credentials
.env
.env.*
!.env.example

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Frontend dependencies and generated build metadata
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/dist/

# Static build output must not be tracked: it is reproducible via npm run build
static/dist/

# Test and quality-tool caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime data produced by Docker and document processing
volumes/
app/storage/
.artifacts/
logs/
*.log

# Transient evaluation reports regenerated by scripts/evaluate_icp_paraphrases.py
/report_v10*.json

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
