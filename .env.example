# Docker Compose 会自动读取仓库根目录的 .env；未创建 .env 时也可使用下列默认值。
SERVER_IP=127.0.0.1
APP_UID=1000
APP_GID=1000

POSTGRES_USER=postgres
# 生产部署必须改为强口令；置 ICP_REQUIRE_STRONG_POSTGRES_PASSWORD=true 后，
# 应用会拒绝空口令或等于旧默认值 "password" 的口令并拒绝启动。
POSTGRES_PASSWORD=password
POSTGRES_DB=knowledge_graph
# ICP_REQUIRE_STRONG_POSTGRES_PASSWORD=false

# CORS 跨域白名单（逗号分隔）；缺省仅放行 localhost/127.0.0.1 开发端口
# CORS_ALLOW_ORIGINS=https://vis.example.com,https://gateway.example.com

# OpenSearch simultaneously provides CJK BM25/full-text and 1024-dimension
# BGE-M3 k-NN retrieval.  Local Compose disables its security plugin and keeps
# this endpoint on loopback; production deployments should enable auth/TLS.
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9201
OPENSEARCH_SCHEME=http
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_ALIAS=knowledge_graph_default
OPENSEARCH_INDEX_VERSION=v1
STRICT_DEPENDENCIES=true

# HugeGraph 1.7 默认图空间；旧版未限定 Gremlin binding 可显式设为空。
HUGEGRAPH_GRAPHSPACE=DEFAULT

MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=262144
MODEL_TIMEOUT=3000
MODEL_TOP_P=0.1
# 回答 + 只读审核 + 最多一次重新审核的修订，共享总时限；单次模型预算另受限。
# ICP_AGENT_ANSWER_TOTAL_TIMEOUT_SECONDS=420
EMBEDDING_DIM=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 仅影响候选相关性分数；不改变身份、证据审批或唯一诊断门禁。未设置时保持原权重。
# ICP_CANDIDATE_RANKING_WEIGHTS={"hmc_exact":0.55,"hmc_components":0.45,"hmc_keyword":0.3,"fmeca":0.25,"search_base":0.1,"search_score":0.15}

# 当前机器 5433 被占用时，取消下一行注释以启用仓库提供的本机覆盖配置。
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
